---
/**
 * Shell for the /redesign/* preview of the generic bounty board.
 *
 * Unlisted, not secret: nothing on the live site links here, and every page
 * ships `noindex, nofollow` so crawlers don't surface it. Deliberately does NOT
 * import global.css — the preview owns its own tokens (src/styles/redesign.css)
 * so it can't inherit or fight the live site's spark-* palette.
 */
import '../styles/redesign.css';

interface Props {
  title: string;
  description?: string;
  /** which nav item to mark current */
  nav?: 'board' | 'hall' | 'events';
}

const { title, description = '', nav } = Astro.props as Props;

const NAV = [
  { key: 'board', label: 'Board', href: '/redesign/' },
  { key: 'hall', label: 'Hall of Fame', href: '/redesign/hall-of-fame' },
  { key: 'events', label: 'Events', href: '/redesign/events' },
  { key: 'how', label: 'How it works', href: '/redesign/#how-it-works' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- preview namespace: keep it out of search results -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Runs before paint to prevent a flash. Shares the live site's storage key
      // so a visitor's choice carries across; falls back to the OS preference
      // (the redesign is light-first, the live OS theme is dark-first).
      (function () {
        var stored = localStorage.getItem('hackbu-theme');
        var theme =
          stored ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="preview-strip">
      Redesign preview — not linked publicly. <a href="/">Back to the live site →</a>
    </div>

    <header class="bar">
      <div class="bar-inner">
        <a href="/redesign/" class="wordmark">SPARK<i>!</i> BOUNTIES</a>
        <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mainNav" aria-label="Toggle navigation">☰</button>
        <nav class="nav" id="mainNav">
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={nav === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <button class="theme-btn" id="themeBtn" aria-label="Toggle light/dark mode" title="Toggle light/dark mode">
            <span id="iconSun" hidden>☀</span><span id="iconMoon">☾</span>
          </button>
          <a class="nav-cta" href="https://discord.gg/hackbu" target="_blank" rel="noopener">Join Discord</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <span>Spark! Bounties · Boston University · HackBU bounties run with BU IS&amp;T</span>
      <span><a href="/">Live site</a> · <a href="https://discord.gg/hackbu" target="_blank" rel="noopener">Discord</a></span>
    </footer>

    <script>
      const btn = document.getElementById('themeBtn');
      const sun = document.getElementById('iconSun');
      const moon = document.getElementById('iconMoon');

      function paint() {
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        // show the icon for the mode you'd switch *to*
        if (sun) sun.hidden = !dark;
        if (moon) moon.hidden = dark;
      }
      paint();

      btn?.addEventListener('click', () => {
        const next =
          document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('hackbu-theme', next);
        paint();
      });

      const navToggle = document.getElementById('navToggle');
      navToggle?.addEventListener('click', () => {
        const open = document.getElementById('mainNav')?.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
